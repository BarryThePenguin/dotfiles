#!/usr/bin/env bash
#MISE description="Re-fetch vendored skills at the commits pinned in skills.toml (--update re-pins them first)"
#MISE quiet=true
#MISE tools={yq="4.54.1"}
#MISE dir="{{cwd}}"
# Copy vendored skills from their upstream repos into the current repo, each at the
# commit pinned in <repo>/skills.toml. Skills land in .agents/skills/<name>, or in
# $SKILLS_DIR (relative to the repo root) when set. A skill path is either a directory
# with a SKILL.md or a single .md file, which becomes <name>/SKILL.md. Each skill also gets the source
# repo's root LICENSE file unless it already ships its own.
#
# Claude Code only reads .claude/skills, so with the default .agents/skills each skill
# is also linked as .claude/skills/<name> -> ../../.agents/skills/<name>. A real
# directory already at that path is left alone.
#
# Local edits to a vendored skill are overwritten; make them upstream, or move the
# skill out of skills.toml and own it.
#
# Usage:
#   mise run skills:sync               re-fetch every source at its pinned commit
#   mise run skills:sync -- --update   fetch each source's default branch and re-pin it (skills:update)
set -euo pipefail

root=$(git rev-parse --show-toplevel)
manifest=$root/skills.toml
dest=$root/${SKILLS_DIR:-.agents/skills}
claude=
[[ -z ${SKILLS_DIR:-} ]] && claude=$root/.claude/skills
update=0
[[ ${1:-} == --update ]] && update=1

[[ -f $manifest ]] || { echo "No skills.toml at $root" >&2; exit 1; }
mkdir -p "$dest"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

while IFS= read -r source; do
  repo=$(yq -p toml -oy ".${source}.repo" "$manifest")
  commit=$(yq -p toml -oy ".${source}.commit" "$manifest")
  checkout=$work/$source
  git init -q "$checkout"
  git -C "$checkout" remote add origin "$repo"
  if ((update)); then
    git -C "$checkout" fetch -q --depth 1 origin HEAD
  else
    git -C "$checkout" fetch -q --depth 1 origin "$commit"
  fi
  git -C "$checkout" checkout -q FETCH_HEAD
  head=$(git -C "$checkout" rev-parse HEAD)

  licence=$(find "$checkout" -maxdepth 1 -type f \( -iname 'LICENSE*' -o -iname 'LICENCE*' -o -iname 'COPYING*' \) | head -n 1)

  while IFS=$'\t' read -r name path; do
    # A skill is a directory with a SKILL.md, or a single .md file installed as <name>/SKILL.md.
    if [[ -f $checkout/$path/SKILL.md ]]; then
      rm -rf "${dest:?}/$name"
      cp -R "$checkout/$path" "$dest/$name"
    elif [[ -f $checkout/$path && $path == *.md ]]; then
      rm -rf "${dest:?}/$name"
      mkdir -p "$dest/$name"
      cp "$checkout/$path" "$dest/$name/SKILL.md"
    else
      echo "$source: neither $path/SKILL.md nor a $path .md file found at $head" >&2
      exit 1
    fi
    if [[ -n $licence ]] && ! compgen -G "$dest/$name/[Ll][Ii][Cc][Ee][Nn][CcSs][Ee]*" > /dev/null; then
      cp "$licence" "$dest/$name/"
    fi
    if [[ -n $claude ]]; then
      mkdir -p "$claude"
      if [[ -e $claude/$name && ! -L $claude/$name ]]; then
        echo "$source: $claude/$name exists and is not a symlink; not linking" >&2
      else
        ln -sfn "../../.agents/skills/$name" "$claude/$name"
      fi
    fi
  done < <(yq -p toml -oy ".${source}.skills | to_entries | .[] | .key + \"\t\" + .value" "$manifest")

  if ((update)) && [[ $head != "$commit" ]]; then
    OLD=$commit NEW=$head perl -pi -e 's/^commit = "\Q$ENV{OLD}\E"/commit = "$ENV{NEW}"/' "$manifest"
    echo "$source: $commit -> $head"
  fi
done < <(yq -p toml -oy 'keys | .[]' "$manifest")

echo "Vendored skills synced. Review with: git -C $root diff --stat"
