{
	"$schema": "https://opencode.ai/config.json",
	"formatter": true,
	"model": "opencode-go/deepseek-v4.1-flash",
	"agents": {
		"build": {
			"model": "opencode-go/deepseek-v4.1-flash#high",
		},
		"general": {
			"model": "opencode-go/deepseek-v4.1-flash",
		},
		"plan": {
			"model": "opencode-go/glm-5.3#max",
		},
		"explore": {
			"model": "opencode-go/deepseek-v4.1-flash#low",
		},
		"title": {
			"model": "opencode-go/beam-free",
		},
	},
	"plugins": [
		"@btp/caffeinate-opencode",
		"@btp/issue-tools-opencode",
		"@wakatime/opencode-wakatime",
	],
	"mcp": {
		"servers": {
			"browse": {
				"type": "local",
				"command": ["/Users/jonno/.local/share/mise/shims/browse", "mcp"],
				"environment": { "OPENCODE_BROWSER_AUTO_UPDATE": "notify" },
			},
			"catalogue": {
				"type": "remote",
				"url": "https://catalogue.jonno.dev/mcp",
			},
			"nogon": {
				"type": "remote",
				"url": "https://search.jonno.dev/mcp",
				"oauth": false,
				"headers": {
					"Authorization": "Bearer {env:NOGON__APP__ACCESS_TOKEN}",
				},
			},
			"mise": {
				"type": "local",
				"command": ["/Users/jonno/.local/bin/mise", "mcp"],
			},
		},
	},
}
