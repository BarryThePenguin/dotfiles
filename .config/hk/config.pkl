amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

// User-level hk config: adds these steps to every project's hooks (pre-commit,
// check, fix). A project step with the same name wins.
steps {
    // See `file-size --help`. Per-repo exclusions go in the repo's `exclude`.
    ["file_size"] = new Step {
        check = "file-size {{files}}"
    }
}
