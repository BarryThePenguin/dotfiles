[alias]
	root = !pwd

[core]
	notesRef = refs/notes/changelog

[notes]
	rewriteRef = refs/notes/changelog

[github]
  	user = barrythepenguin

[hub]
	protocol = ssh:

[init]
	defaultBranch = main

[gpg]
	format = ssh

[gpg "ssh"]
  	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = {{ env.HOME }}/.ssh/allowed_signers

[merge]
	conflictstyle = zdiff3
	tool = vscode

[push]
	default = simple

[pull]
	rebase = true

[rebase]
	autoStash = true
	updateRefs = true

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[includeIf "gitdir:~/src/"]
	path = ~/.config/git/btp.gitconfig

[includeIf "gitdir:~/src/work/"]
	path = ~/.config/git/work.gitconfig

[mergetool "vscode"]
	cmd = code --wait $MERGED

[diff]
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[hook "hk-commit-msg"]
        command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run commit-msg --from-hook
        event = commit-msg

[hook "hk-pre-commit"]
        command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-commit --from-hook --staged
        event = pre-commit

[hook "hk-pre-push"]
        command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run pre-push --from-hook
        event = pre-push

[hook "hk-prepare-commit-msg"]
        command = test \"${HK:-1}\" = \"0\" || ~/.local/bin/mise x hk -- hk run prepare-commit-msg --from-hook
        event = prepare-commit-msg
