amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"
// Using a coding agent? See https://hk.jdx.dev/agents

local linters = new Mapping<String, Step> {
    ["eslint"] = Builtins.eslint
    ["knip"] = Builtins.knip
    ["prettier"] = Builtins.prettier
    // The bash scripts have no .sh extension, and the zsh ones (scripts/+x,
    // scripts/fix-gpg) are beyond shellcheck, so the files are listed.
    ["shellcheck"] = new Step {
        glob = List(
            ".config/mise/tasks/age/key",
            ".config/mise/tasks/net/*",
            "bin/bootstrap",
            "scripts/*.sh"
        )
        check = "shellcheck {{files}}"
    }
    // shellcheck cannot see a logic bug in a bash task. Run the net:check
    // regression test whenever the task or its test changes.
    ["net_check_test"] = new Step {
        glob = List(".config/mise/tasks/net/check", "scripts/net-check.test.sh")
        check = "scripts/net-check.test.sh"
    }
}

// mise's per-tool lockfiles (.config/mise/locks/**) are generated, vendored
// package.json/lockfile pairs, not project source — exclude them from linting.
exclude = List(".config/mise/locks/**")

steps = linters
